{
  "name": "Senvia",
  "author": "Mehdi (belcaid)",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:web-sqlite": "mkdir -p public/assets && cp node_modules/sql.js/dist/sql-wasm.wasm public/assets/sql-wasm.wasm",
    "predev": "npm run prepare:web-sqlite",
    "prebuild": "npm run prepare:web-sqlite",
    "ionic:serve": "npm run dev",
    "ionic:build": "npm run build",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run --browser chrome",
    "test:unit": "vitest",
    "test:unit:run": "vitest --run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor-community/sqlite": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "8.0.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capacitor/toast": "^8.0.1",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "gsap": "^3.14.2",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "sql.js": "1.11.0",
    "vue": "^3.5.43",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "2.4.6",
    "cypress": "^16.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "description": "Application locale de suivi de plantes avec capteurs BLE Flower Care / HHCC"
}
